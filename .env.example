# AgentNexus Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed as a reference.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
AGENT_NEXUS_HOST=0.0.0.0
AGENT_NEXUS_PORT=10086

# Outward-facing base URL written into client artifacts (steering file,
# nexus_push.py, curl examples). Leave unset for local development —
# defaults to http://localhost:<AGENT_NEXUS_PORT>. Set this for any
# non-localhost deployment so onboarded agents talk to the right host.
# AGENT_NEXUS_PUBLIC_URL=http://your-host:10086

# ---------------------------------------------------------------------------
# SSL / HTTPS (optional — leave unset for plain HTTP in local development)
# Set both to enable HTTPS. Paths must be readable by the server process.
# Example (Let's Encrypt):
#   AGENT_NEXUS_SSL_CERTFILE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
#   AGENT_NEXUS_SSL_KEYFILE=/etc/letsencrypt/live/your-domain.com/privkey.pem
# ---------------------------------------------------------------------------
# AGENT_NEXUS_SSL_CERTFILE=
# AGENT_NEXUS_SSL_KEYFILE=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
AGENT_NEXUS_DB_URL=sqlite:///agent_nexus.db

# ---------------------------------------------------------------------------
# Workspace (document storage root)
# ---------------------------------------------------------------------------
AGENT_NEXUS_DOCS_ROOT=./workspace

# ---------------------------------------------------------------------------
# Bootstrap (optional)
# ---------------------------------------------------------------------------
AGENT_NEXUS_DEFAULT_SPACE_ID=default

# ---------------------------------------------------------------------------
# MCP Transport
# Set to "stdio" for Glama / single-client introspection mode.
# Default is "streamable-http" for multi-agent use.
# ---------------------------------------------------------------------------
# MCP_TRANSPORT=streamable-http

# ---------------------------------------------------------------------------
# Planner LLM (optional — leave PLANNER_LLM_API_KEY unset to disable AI features)
# ---------------------------------------------------------------------------

# Provider: openai | anthropic  (aliases: gpt, claude)
PLANNER_LLM_PROVIDER=openai

# Model ID — leave blank to use the provider default (gpt-4o / claude-3-5-sonnet)
# PLANNER_LLM_MODEL=gpt-4o

# API key — required to enable planner_chat / planner_plan / planner_overview and Web AI Chat
# PLANNER_LLM_API_KEY=sk-...

# Custom API endpoint — for OpenAI-compatible APIs (Azure, Ollama, third-party proxies, etc.)
# Leave blank to use the provider's official endpoint.
# Examples:
#   Azure:  https://<resource>.openai.azure.com/
#   Ollama: http://localhost:11434/v1
# PLANNER_LLM_BASE_URL=
